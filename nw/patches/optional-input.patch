+test("InputManager.initialize stays disconnected without enabling MIDI when no device is selected", async () => {
+  const previous = global.__nwWrldWebMidiOverride;
+  let enableCalls = 0;
+  const statuses = [];
+  const window = {
+    isDestroyed: () => false,
+    webContents: { isDestroyed: () => false, send: (_channel, payload) => statuses.push(payload) },
+  };
+  try {
+    global.__nwWrldWebMidiOverride = { enabled: false, enable: () => { enableCalls += 1; } };
+    const manager = new InputManager(window, window);
+    await manager.initialize({
+      type: "midi", trackSelectionChannel: 2, methodTriggerChannel: 1,
+      velocitySensitive: false, port: 8000,
+    });
+    assert.equal(enableCalls, 0);
+    assert.equal(manager.currentSource, null);
+    assert.equal(statuses.at(-1).data.status, "disconnected");
+  } finally {
+    if (previous === undefined) delete global.__nwWrldWebMidiOverride;
+    else global.__nwWrldWebMidiOverride = previous;
+  }
+});
