{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "three": [
        "node_modules/@types/three"
      ],
      "three/*": [
        "node_modules/@types/three/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
